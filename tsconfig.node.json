{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `chrome` because the e2e specs evaluate code *inside* the extension's
    // service worker, where the API is real. The types are the same ones
    // `tsconfig.json` uses for `src`; without them the specs typecheck against
    // an environment that does not match where their code runs — which is the
    // exact class of mistake this suite has been chasing.
    "types": ["node", "chrome"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "allowJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "*.config.ts",
    "scripts/**/*",
    "tests/e2e/**/*.spec.ts",
    "tests/e2e/global-setup.ts",
    "tests/e2e/harness/harness.d.ts"
  ]
}
